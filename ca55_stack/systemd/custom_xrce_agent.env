# /etc/default/custom_xrce_agent
# Loaded by custom_xrce_agent.service via EnvironmentFile=
# All parameters are runtime-tunable — no rebuild needed after changing this file.

# ── Video destinations ──────────────────────────────────────────────────────
# Comma-separated host list — multiudpsink fans out with ONE encode (zero extra CPU)
QGC_IP=192.168.1.188,192.168.1.126

# ── Encoder ────────────────────────────────────────────────────────────────
# QGC_BITRATE: encoder target bitrate in bits/s
#   H.265 (HEVC) uses ~50% less bandwidth than H.264 at equal visual quality.
#   2000000 (2 Mbps)  — H.265 default; visual quality ≈ H.264 @ 4 Mbps
#   4000000 (4 Mbps)  — excellent H.265; broadcast-grade indoors
#   6000000 (6 Mbps)  — H.265 broadcast; reserve for 802.11ac 5GHz only
QGC_BITRATE=2000000

# QGC_CODEC: h264 (default) or h265 (HEVC — ~50% less bandwidth, same visual quality)
#   h265 requires QGC ≥ v4.x: Application Settings → Video → UDP H.265 Video Stream
QGC_CODEC=h265

# STREAM_FPS_DIV: stream every Nth camera frame (AI inference always runs at full CAM_FPS)
#   1 — full framerate (default)
#   2 — half framerate (15fps at 30fps camera) — use on 2.4GHz WiFi or to free CPU for SLAM
STREAM_FPS_DIV=1

# ── Camera ─────────────────────────────────────────────────────────────────
AI_CAMERA=/dev/video0
CAM_WIDTH=640
CAM_HEIGHT=480
CAM_FPS=30

# ── AI model ───────────────────────────────────────────────────────────────
AI_MODEL=/home/root/ai_models/yolov8n
